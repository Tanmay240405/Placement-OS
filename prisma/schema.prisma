// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Models ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  opportunities Opportunity[]

  dsaSettings      DsaSettings?
  roadmapProgress  RoadmapProgress[]
  patternProgress  PatternProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Application Models ─────────────────────────────────────────

model Opportunity {
  id               String    @id @default(cuid())
  userId           String
  gmailMessageId   String
  threadId         String?

  companyName      String?
  category         String?

  deadlineRaw      String?
  deadlineDatetime DateTime?

  applicationUrl   String?

  emailSubject     String?
  senderEmail      String?
  receivedAt       DateTime?

  status           String    @default("NOT_REGISTERED")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles OpportunityRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gmailMessageId])
  @@index([userId])
}

model OpportunityRole {
  id            String      @id @default(cuid())
  opportunityId String
  roleName      String

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

// ─── DSA Dashboard Models ───────────────────────────────────────

model DsaSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  leetcodeUsername    String?
  totalProblemsSolved Int      @default(0)
  targetProblems      Int      @default(300)
  codeforcesRating    Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoadmapProgress {
  id          String    @id @default(cuid())
  userId      String
  topicId     String
  subtopicId  String
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, subtopicId])
}

model PatternProgress {
  id              String   @id @default(cuid())
  userId          String
  patternId       String
  status          String   @default("Not Started")
  optionalProgress Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
}
